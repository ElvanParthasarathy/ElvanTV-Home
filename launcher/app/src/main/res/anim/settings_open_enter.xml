<?xml version="1.0" encoding="utf-8"?>
<!-- A Settings screen opened from our panel: slides in from the right edge, over the panel that stays behind. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:duration="320">
    <translate android:fromXDelta="30%" android:toXDelta="0" />
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="200" />
</set>
