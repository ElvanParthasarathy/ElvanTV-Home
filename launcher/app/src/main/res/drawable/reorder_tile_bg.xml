<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent frosted squircle tile background for Google TV Reorder tile.
     Translucent (#2EFFFFFF) allows the vibrant ambient glow behind it to pass through. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#2EFFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#14FFFFFF" />
    <corners android:radius="13dp" />
</shape>
