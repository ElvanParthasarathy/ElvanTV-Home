<?xml version="1.0" encoding="utf-8"?>
<!-- One row of a Google TV style menu: Material icon and label, a light pill when focused. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="20dp"
    android:background="@drawable/menu_row_bg"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:tint="@drawable/menu_text"
        android:duplicateParentState="true"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical"
        android:duplicateParentState="true">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@drawable/menu_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@string/font_medium"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@drawable/menu_text_dim"
            android:duplicateParentState="true"
            android:textSize="12sp"
            android:fontFamily="@string/font_body"
            android:includeFontPadding="false"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="12dp"
        android:src="@drawable/ic_menu_check"
        android:tint="@drawable/menu_text"
        android:duplicateParentState="true"
        android:visibility="gone"
        android:contentDescription="@null" />
</LinearLayout>
